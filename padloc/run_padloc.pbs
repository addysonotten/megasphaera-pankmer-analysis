#!/bin/bash
#PBS -N padloc
#PBS -l nodes=1:ppn=4
#PBS -l walltime=04:00:00
#PBS -l mem=16gb
#PBS -j oe
#PBS -o /home/ottena/mags_project/padloc_analysis/logs/
#PBS -J 1-61

# Paths
GENOME_LIST=/home/ottena/mags_project/genome_list.txt
BAKTA_DIR=/home/ottena/mags_project/bakta_analysis/output
OUTDIR=/home/ottena/mags_project/padloc_analysis/output
SIF=/home/ottena/mags_project/padloc_analysis/padloc.sif
DB=/home/ottena/mags_project/padloc_analysis/db

# Get genome name for this array task
GENOME=$(sed -n "${PBS_ARRAY_INDEX}p" $GENOME_LIST)

echo "Running PADLOC on: $GENOME"

mkdir -p $OUTDIR/$GENOME

apptainer exec --bind $DB:/usr/local/bin/../data \
    $SIF padloc \
    --faa $BAKTA_DIR/$GENOME/$GENOME.faa \
    --gff $BAKTA_DIR/$GENOME/$GENOME.gff3 \
    --outdir $OUTDIR/$GENOME

echo "Done: $GENOME"
